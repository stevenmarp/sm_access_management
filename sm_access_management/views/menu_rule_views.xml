<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sm_menu_rule_view_list" model="ir.ui.view">
        <field name="name">sm.menu.rule.list</field>
        <field name="model">sm.menu.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="menu_id" string="Menu"
                       widget="many2one"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Search menu..."/>
                <field name="menu_full_name" string="Menu Path"/>
                <field name="group_ids" widget="many2many_tags" placeholder="All users"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="sm_menu_rule_view_form" model="ir.ui.view">
        <field name="name">sm.menu.rule.form</field>
        <field name="model">sm.menu.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Target">
                            <field name="menu_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="menu_full_name"/>
                            <field name="group_ids" widget="many2many_tags"
                                   placeholder="Leave empty = all users"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sm_menu_rule_action" model="ir.actions.act_window">
        <field name="name">Menu Access Rules</field>
        <field name="res_model">sm.menu.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Menu Access Rule</p>
            <p>Hide any menu or submenu per user group.</p>
        </field>
    </record>

</odoo>
