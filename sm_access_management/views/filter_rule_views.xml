<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sm_filter_rule_view_list" model="ir.ui.view">
        <field name="name">sm.filter.rule.list</field>
        <field name="model">sm.filter.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_id"/>
                <field name="target_type"/>
                <field name="filter_name"/>
                <field name="filter_label"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="sm_filter_rule_view_form" model="ir.ui.view">
        <field name="name">sm.filter.rule.form</field>
        <field name="model">sm.filter.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Target">
                            <field name="model_id"/>
                            <field name="target_type" widget="radio"/>
                            <field name="filter_name"/>
                            <field name="filter_label"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sm_filter_rule_action" model="ir.actions.act_window">
        <field name="name">Filter Access Rules</field>
        <field name="res_model">sm.filter.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Filter Access Rule</p>
            <p>Hide specific search filters or group-by options per model.</p>
        </field>
    </record>

</odoo>
