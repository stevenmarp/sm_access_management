<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sm_field_rule_view_list" model="ir.ui.view">
        <field name="name">sm.field.rule.list</field>
        <field name="model">sm.field.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_id" placeholder="Select model first..."/>
                <field name="field_id"
                       domain="[('model_id', '=', model_id), ('ttype', 'not in', ['one2many'])]"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Select field..."
                       context="{'show_technical_name': True}"/>
                <field name="group_ids" widget="many2many_tags" placeholder="All users"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="make_invisible" widget="boolean_toggle"/>
                <field name="make_readonly" widget="boolean_toggle"/>
                <field name="make_required" widget="boolean_toggle"/>
                <field name="remove_external_link" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="sm_field_rule_view_form" model="ir.ui.view">
        <field name="name">sm.field.rule.form</field>
        <field name="model">sm.field.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="Target">
                            <field name="model_id"/>
                            <field name="field_id"
                                   domain="[('model_id', '=', model_id), ('ttype', 'not in', ['one2many'])]"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="field_ttype" readonly="1"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Restrictions">
                            <field name="make_invisible"/>
                            <field name="make_readonly"/>
                            <field name="make_required"/>
                            <field name="remove_external_link"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sm_field_rule_view_search" model="ir.ui.view">
        <field name="name">sm.field.rule.search</field>
        <field name="model">sm.field.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <field name="field_id"/>
                <field name="group_ids"/>
                <separator/>
                <filter name="groupby_model" string="Model" context="{'group_by':'model_id'}"/>
            </search>
        </field>
    </record>

    <record id="sm_field_rule_action" model="ir.actions.act_window">
        <field name="name">Field Access Rules</field>
        <field name="res_model">sm.field.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Field Access Rule</p>
            <p>Make any field invisible, read-only, or required per model, per group.</p>
        </field>
    </record>

</odoo>
