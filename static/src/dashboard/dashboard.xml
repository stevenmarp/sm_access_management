<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="sm_access_management.Dashboard">
    <div class="o_action sm_access_dashboard p-4">

        <!-- Loading -->
        <div t-if="state.loading" class="text-center p-5">
            <i class="fa fa-spinner fa-spin fa-3x text-primary"/>
            <p class="mt-3 text-muted">Loading dashboard...</p>
        </div>

        <!-- Dashboard Content -->
        <div t-if="!state.loading and state.data">

            <!-- Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="flex-grow-1">
                    <h2 class="mb-1" style="color: #009688;">
                        <i class="fa fa-shield me-2"/>Access Management Dashboard
                    </h2>
                    <p class="text-muted mb-0">
                        Overview of all access rules configured in the system
                    </p>
                </div>
                <div>
                    <span class="badge bg-primary fs-5 p-2">
                        <t t-esc="state.data.total_rules"/> Total Rules
                    </span>
                    <span class="badge bg-info fs-5 p-2 ms-2">
                        <t t-esc="state.data.total_models_affected"/> Models Affected
                    </span>
                </div>
            </div>

            <!-- Stats Cards Row -->
            <div class="row g-3 mb-4">

                <!-- Model Access -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 cursor-pointer"
                         style="border-left: 4px solid #009688 !important;"
                         t-on-click="openModelAccess">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 50px; height: 50px; background: #E0F2F1;">
                                <i class="fa fa-lock fa-lg" style="color: #009688;"/>
                            </div>
                            <div>
                                <h3 class="mb-0"><t t-esc="state.data.counts.model_access"/></h3>
                                <small class="text-muted">Model Access Rules</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Field Access -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 cursor-pointer"
                         style="border-left: 4px solid #FF9800 !important;"
                         t-on-click="openFieldAccess">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 50px; height: 50px; background: #FFF3E0;">
                                <i class="fa fa-pencil fa-lg" style="color: #FF9800;"/>
                            </div>
                            <div>
                                <h3 class="mb-0"><t t-esc="state.data.counts.field_access"/></h3>
                                <small class="text-muted">Field Access Rules</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Menu Access -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 cursor-pointer"
                         style="border-left: 4px solid #2196F3 !important;"
                         t-on-click="openMenuAccess">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 50px; height: 50px; background: #E3F2FD;">
                                <i class="fa fa-bars fa-lg" style="color: #2196F3;"/>
                            </div>
                            <div>
                                <h3 class="mb-0"><t t-esc="state.data.counts.menu_access"/></h3>
                                <small class="text-muted">Menu Access Rules</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Button/Tab Access -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 cursor-pointer"
                         style="border-left: 4px solid #9C27B0 !important;"
                         t-on-click="openButtonAccess">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 50px; height: 50px; background: #F3E5F5;">
                                <i class="fa fa-hand-pointer-o fa-lg" style="color: #9C27B0;"/>
                            </div>
                            <div>
                                <h3 class="mb-0"><t t-esc="state.data.counts.button_access"/></h3>
                                <small class="text-muted">Button/Tab Rules</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chatter Access -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 cursor-pointer"
                         style="border-left: 4px solid #00BCD4 !important;"
                         t-on-click="openChatterAccess">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 50px; height: 50px; background: #E0F7FA;">
                                <i class="fa fa-comments fa-lg" style="color: #00BCD4;"/>
                            </div>
                            <div>
                                <h3 class="mb-0"><t t-esc="state.data.counts.chatter_access"/></h3>
                                <small class="text-muted">Chatter Rules</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filter Access -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 cursor-pointer"
                         style="border-left: 4px solid #795548 !important;"
                         t-on-click="openFilterAccess">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 50px; height: 50px; background: #EFEBE9;">
                                <i class="fa fa-filter fa-lg" style="color: #795548;"/>
                            </div>
                            <div>
                                <h3 class="mb-0"><t t-esc="state.data.counts.filter_access"/></h3>
                                <small class="text-muted">Filter Rules</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Global Settings -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 cursor-pointer"
                         style="border-left: 4px solid #F44336 !important;"
                         t-on-click="openGlobalAccess">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 50px; height: 50px; background: #FFEBEE;">
                                <i class="fa fa-globe fa-lg" style="color: #F44336;"/>
                            </div>
                            <div>
                                <h3 class="mb-0"><t t-esc="state.data.counts.global_access"/></h3>
                                <small class="text-muted">Global Rules</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Domain Rules -->
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 cursor-pointer"
                         style="border-left: 4px solid #607D8B !important;"
                         t-on-click="openDomainAccess">
                        <div class="card-body d-flex align-items-center">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width: 50px; height: 50px; background: #ECEFF1;">
                                <i class="fa fa-code fa-lg" style="color: #607D8B;"/>
                            </div>
                            <div>
                                <h3 class="mb-0"><t t-esc="state.data.counts.domain_access"/></h3>
                                <small class="text-muted">Domain Rules</small>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Second Row: Global Status + Affected Models -->
            <div class="row g-3 mb-4">

                <!-- Global Status Badges -->
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0"><i class="fa fa-globe me-2 text-danger"/>Global Settings Status</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex flex-wrap gap-2">
                                <span t-attf-class="badge fs-6 p-2 #{state.data.global_summary.debug_disabled ? 'bg-danger' : 'bg-secondary'}">
                                    <i t-attf-class="fa #{state.data.global_summary.debug_disabled ? 'fa-check' : 'fa-times'} me-1"/>
                                    Debug Mode
                                </span>
                                <span t-attf-class="badge fs-6 p-2 #{state.data.global_summary.readonly_users ? 'bg-danger' : 'bg-secondary'}">
                                    <i t-attf-class="fa #{state.data.global_summary.readonly_users ? 'fa-check' : 'fa-times'} me-1"/>
                                    Read-Only Users
                                </span>
                                <span t-attf-class="badge fs-6 p-2 #{state.data.global_summary.import_hidden ? 'bg-warning text-dark' : 'bg-secondary'}">
                                    <i t-attf-class="fa #{state.data.global_summary.import_hidden ? 'fa-check' : 'fa-times'} me-1"/>
                                    Import Hidden
                                </span>
                                <span t-attf-class="badge fs-6 p-2 #{state.data.global_summary.export_hidden ? 'bg-warning text-dark' : 'bg-secondary'}">
                                    <i t-attf-class="fa #{state.data.global_summary.export_hidden ? 'fa-check' : 'fa-times'} me-1"/>
                                    Export Hidden
                                </span>
                                <span t-attf-class="badge fs-6 p-2 #{state.data.global_summary.chatter_hidden ? 'bg-info' : 'bg-secondary'}">
                                    <i t-attf-class="fa #{state.data.global_summary.chatter_hidden ? 'fa-check' : 'fa-times'} me-1"/>
                                    Chatter Hidden
                                </span>
                            </div>
                            <p class="text-muted mt-3 mb-0">
                                <small>
                                    <span class="badge bg-danger">Red</span> = Active restriction,
                                    <span class="badge bg-secondary">Gray</span> = Not active
                                </small>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Affected Models -->
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0"><i class="fa fa-database me-2" style="color: #009688;"/>Affected Models</h5>
                        </div>
                        <div class="card-body" style="max-height: 200px; overflow-y: auto;">
                            <div t-if="state.data.affected_models.length === 0" class="text-muted text-center py-3">
                                No models affected yet. Create your first rule!
                            </div>
                            <div class="d-flex flex-wrap gap-1">
                                <t t-foreach="state.data.affected_models" t-as="model" t-key="model">
                                    <span class="badge bg-light text-dark border p-2">
                                        <i class="fa fa-cube me-1" style="color: #009688;"/>
                                        <t t-esc="model"/>
                                    </span>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Recent Rules Tables -->
            <div class="row g-3">

                <!-- Recent Model Rules -->
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0"><i class="fa fa-lock me-2" style="color: #009688;"/>Recent Model Rules</h5>
                        </div>
                        <div class="card-body p-0">
                            <div t-if="!state.data.recent_model_rules.length" class="text-muted text-center py-3">
                                No rules yet
                            </div>
                            <table t-if="state.data.recent_model_rules.length" class="table table-sm mb-0">
                                <tbody>
                                    <t t-foreach="state.data.recent_model_rules" t-as="rule" t-key="rule.id">
                                        <tr>
                                            <td><strong><t t-esc="rule.model"/></strong></td>
                                            <td class="text-muted"><t t-esc="rule.groups"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Recent Field Rules -->
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0"><i class="fa fa-pencil me-2" style="color: #FF9800;"/>Recent Field Rules</h5>
                        </div>
                        <div class="card-body p-0">
                            <div t-if="!state.data.recent_field_rules.length" class="text-muted text-center py-3">
                                No rules yet
                            </div>
                            <table t-if="state.data.recent_field_rules.length" class="table table-sm mb-0">
                                <tbody>
                                    <t t-foreach="state.data.recent_field_rules" t-as="rule" t-key="rule.id">
                                        <tr>
                                            <td><strong><t t-esc="rule.name"/></strong></td>
                                            <td class="text-muted"><t t-esc="rule.groups"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Recent Menu Rules -->
                <div class="col-lg-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="mb-0"><i class="fa fa-bars me-2" style="color: #2196F3;"/>Recent Menu Rules</h5>
                        </div>
                        <div class="card-body p-0">
                            <div t-if="!state.data.recent_menu_rules.length" class="text-muted text-center py-3">
                                No rules yet
                            </div>
                            <table t-if="state.data.recent_menu_rules.length" class="table table-sm mb-0">
                                <tbody>
                                    <t t-foreach="state.data.recent_menu_rules" t-as="rule" t-key="rule.id">
                                        <tr>
                                            <td><strong><t t-esc="rule.name"/></strong></td>
                                            <td class="text-muted"><t t-esc="rule.groups"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <!-- No Data -->
        <div t-if="!state.loading and !state.data" class="text-center p-5">
            <i class="fa fa-exclamation-triangle fa-3x text-warning"/>
            <p class="mt-3 text-muted">Failed to load dashboard data. Please refresh.</p>
        </div>

    </div>
</t>

</templates>
