<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sm_chatter_rule_view_list" model="ir.ui.view">
        <field name="name">sm.chatter.rule.list</field>
        <field name="model">sm.chatter.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_id"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="hide_chatter" widget="boolean_toggle"/>
                <field name="hide_send_message" widget="boolean_toggle"/>
                <field name="hide_log_note" widget="boolean_toggle"/>
                <field name="hide_activities" widget="boolean_toggle"/>
                <field name="hide_followers" widget="boolean_toggle"/>
                <field name="hide_scheduled_messages" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="sm_chatter_rule_view_form" model="ir.ui.view">
        <field name="name">sm.chatter.rule.form</field>
        <field name="model">sm.chatter.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Target">
                            <field name="model_id"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Hide Components">
                            <field name="hide_chatter"/>
                            <field name="hide_send_message"/>
                            <field name="hide_log_note"/>
                            <field name="hide_activities"/>
                            <field name="hide_followers"/>
                            <field name="hide_scheduled_messages"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sm_chatter_rule_action" model="ir.actions.act_window">
        <field name="name">Chatter Access Rules</field>
        <field name="res_model">sm.chatter.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Chatter Access Rule</p>
            <p>Hide Send Message, Log Note, Activities, Followers per model.</p>
        </field>
    </record>

</odoo>
