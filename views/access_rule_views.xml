<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="sm_access_rule_view_list" model="ir.ui.view">
        <field name="name">sm.access.rule.list</field>
        <field name="model">sm.access.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_id"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="hide_archive" widget="boolean_toggle"/>
                <field name="hide_unarchive" widget="boolean_toggle"/>
                <field name="hide_duplicate" widget="boolean_toggle"/>
                <field name="hide_delete" widget="boolean_toggle"/>
                <field name="hide_create" widget="boolean_toggle"/>
                <field name="hide_edit" widget="boolean_toggle"/>
                <field name="hide_import" widget="boolean_toggle"/>
                <field name="hide_export" widget="boolean_toggle"/>
                <field name="hide_property" widget="boolean_toggle" optional="hide"/>
                <field name="hide_spreadsheet" widget="boolean_toggle" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="sm_access_rule_view_form" model="ir.ui.view">
        <field name="name">sm.access.rule.form</field>
        <field name="model">sm.access.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_toggle_all" type="object"
                                string="Toggle All" class="oe_stat_button"
                                icon="fa-check-square-o"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="Target">
                            <field name="model_id"/>
                            <field name="model_name" invisible="1"/>
                            <field name="group_ids" widget="many2many_tags"
                                   placeholder="Leave empty = All Users"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Hide Actions">
                            <field name="hide_archive"/>
                            <field name="hide_unarchive"/>
                            <field name="hide_duplicate"/>
                            <field name="hide_delete"/>
                            <field name="hide_create"/>
                            <field name="hide_edit"/>
                            <field name="hide_import"/>
                            <field name="hide_export"/>
                            <field name="hide_property"/>
                            <field name="hide_spreadsheet"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Internal notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="sm_access_rule_view_search" model="ir.ui.view">
        <field name="name">sm.access.rule.search</field>
        <field name="model">sm.access.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <field name="group_ids"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="groupby_model" string="Model" context="{'group_by':'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="sm_access_rule_action" model="ir.actions.act_window">
        <field name="name">Model Access Rules</field>
        <field name="res_model">sm.access.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Model Access Rule
            </p>
            <p>Hide Archive, Delete, Duplicate, Create, Edit, Import, Export per model and per group.</p>
        </field>
    </record>

</odoo>
